generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USUARIO
}

enum StatusRascunho {
  EM_PREENCHIMENTO
  CONCLUIDO
}

// Staff que administra o módulo (cadastra clientes, acompanha rascunhos).
// Independente do login do cliente e independente da tabela Usuario do
// projeto Flow Visto Americano (bancos separados de propósito).
model Usuario {
  id        String   @id @default(cuid())
  username  String   @unique
  senhaHash String
  role      Role     @default(USUARIO)
  criadoEm  DateTime @default(now())
}

// Linha única (singleton) guardando o schema do formulário — pages,
// campos, opções e condicionais — como veio de
// scripts/converter-schema.ts, mas editável depois pelo admin (ver
// /admin/formulario) sem precisar de deploy de código.
model FormularioSchema {
  id           String   @id @default(cuid())
  paginas      Json
  atualizadoEm DateTime @updatedAt
}

// Snapshot do `paginas` do FormularioSchema tirado ANTES de cada
// alteração estrutural feita pelo builder (/admin/formulario) — add,
// exclusão, reordenação ou troca de tipo/sub-campos de campo. Edições
// leves (label, obrigatório, opções, condicional) também geram snapshot.
// Serve pra restaurar o formulário inteiro se um save quebrar algo.
// Mantém no máximo os últimos MAX_BACKUPS (ver src/lib/formulario-backup.ts).
model FormularioSchemaBackup {
  id       String   @id @default(cuid())
  paginas  Json
  motivo   String
  criadoEm DateTime @default(now())

  @@index([criadoEm])
}

model ClienteDs160 {
  id String @id @default(cuid())

  // Referência solta pro Cliente.id do Flow Visto Americano — sem FK real
  // entre bancos, só pra rastreabilidade manual (colado pelo admin).
  flowClienteId String?

  nome     String
  cpf      String? @unique
  telefone String? // obrigatório na prática: usado pro envio do link via WhatsApp

  // Login do cliente é e-mail + CPF (senha) juntos, não só o e-mail — de
  // propósito não é @unique: uma família inteira pode logar com o mesmo
  // e-mail/telefone do responsável, um cadastro por pessoa (nome e CPF
  // diferentes cada um). O e-mail sozinho bate com o texto do template de
  // WhatsApp já aprovado na Meta ("utilize o e-mail cadastrado").
  email     String
  senhaHash String // senha é o CPF (ver src/lib/senha.ts)

  status StatusRascunho @default(EM_PREENCHIMENTO)

  // Respostas do formulário: { [fieldId: string]: valor }. Schema fixo
  // (ver src/lib/formulario-schema.ts), não precisa de tabela normalizada.
  respostas Json @default("{}")

  paginaAtual Int @default(0) // índice da última página vista, pra retomar exatamente de onde parou

  concluidoEm DateTime? // quando o cliente marcou o rascunho como concluído
  pdfGeradoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([flowClienteId])
}
